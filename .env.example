# Provider keys are optional individually. Nova routes to the selected provider,
# then tries other configured providers if it fails before streaming begins.
GEMINI_API_KEY=

# Groq chat completions
GROQ_API_KEY=

# OpenRouter chat completions
OPENROUTER_API_KEY=

# Cloudflare Workers AI chat and embeddings
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional public app URL, used by OpenRouter for request attribution.
APP_URL=http://localhost:3002
